      "parameters": {
        "jsCode": "const jobs = items;\n\nlet body = `\n<h2>🔥 Daily AI/Data Opportunities</h2>\n\n<p>Hello Applicant,</p>\n\n<p>Here are today's highest-scoring jobs.</p>\n\n<hr>\n`;\n\njobs.forEach((item, index) => {\n\n    const job = item.json;\n\n    body += `\n    <h3>${index + 1}. ${job.title}</h3>\n\n    <b>🏢 Company:</b> ${job.company}<br>\n\n    <b>📍 Location:</b> ${job.location}<br>\n\n    <b>⭐ Relevance Score:</b> ${job.score}<br>\n\n    <b>📅 Published:</b> ${job.published_at}<br>\n\n    <p>\n      <a href=\"${job.url}\">👉 Apply Here</a>\n    </p>\n\n    <hr>\n    `;\n});\n\nbody += `\n<p><b>Total Jobs:</b> ${jobs.length}</p>\n\n<p>Generated automatically by your AI Job Hunter.</p>\n`;\n\nreturn [\n{\njson:{\nsubject:`🔥 Daily AI/Data Opportunities (${jobs.length} Jobs)`,\nbody\n}\n}\n];"
      },
