        "jsCode": "const allItems = $input.all();\n\nconst existingUrls = new Set();\nconst newJobs = [];\n\nfor (const item of allItems) {\n\n    if (item.json.title) {\n        newJobs.push(item);\n    } else if (item.json.url) {\n        existingUrls.add(item.json.url);\n    }\n\n}\n\nreturn newJobs.filter(job => !existingUrls.has(job.json.url));"
