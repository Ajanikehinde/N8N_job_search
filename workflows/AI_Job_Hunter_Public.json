    {
      "parameters": {
        "jsCode": "return items.filter(item => {\n  const title = (item.json.title || \"\").toLowerCase();\n  const location = (item.json.location || \"\").toLowerCase();\n\n  const keywords = [\n    \"data\",\n    \"analyst\",\n    \"analytics\",\n    \"engineer\",\n    \"machine learning\",\n    \"ml\",\n    \"ai\",\n    \"data engineer\",\n    \"data scientist\",\n    \"backend\",\n    \"platform\",\n    \"security\",\n    \"cyber\"\n  ];\n\n  const match = keywords.some(k => title.includes(k));\n\n  const geoBoost =\n    location.includes(\"remote\") ||\n    location.includes(\"united kingdom\") ||\n    location.includes(\"europe\");\n\n  return match || geoBoost;\n}).map(i => ({ json: i.json }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -28432,
        3088
      ],
      "id": "116ddfdb-28ed-4e04-8118-9f6953bb27ec",
      "name": "Keyword Filter"
    },
    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  const job = item.json;\n\n  let score = 0;\n  const title = (job.title || \"\").toLowerCase();\n  const location = (job.location || \"\").toLowerCase();\n\n  // Role relevance\n  if (title.includes(\"data engineer\")) score += 10;\n  if (title.includes(\"data scientist\")) score += 10;\n  if (title.includes(\"analyst\")) score += 8;\n  if (title.includes(\"machine learning\")) score += 9;\n  if (title.includes(\"ai\")) score += 7;\n  if (title.includes(\"platform\")) score += 5;\n  if (title.includes(\"security\")) score += 6;\n\n  // Location boost\n  if (location.includes(\"remote\")) score += 5;\n  if (location.includes(\"united kingdom\")) score += 6;\n  if (location.includes(\"europe\")) score += 4;\n\n  // Company bonus (optional)\n  if (job.company_name === \"Airbnb\") score += 2;\n\n  return {\n    json: {\n      ...job,\n      score\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -28224,
        3088
      ],
      "id": "649980c9-a925-4a34-a01b-45ecdec49ddd",
      "name": "Score Jobs"
    },
    {
      "parameters": {
        "jsCode": "const sorted = items\n  .sort((a, b) => b.json.score - a.json.score)\n  .slice(0, 15);\n\nreturn sorted;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -28016,
        3088
      ],
      "id": "d1c35e74-2176-4f32-b247-3cf112cb9151",
      "name": "Sort and Top 15"
    },
